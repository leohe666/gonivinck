/* 登录页样式 */
.page {
  min-height: 100vh;
  padding: 0 64rpx;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #07c160 0%, #05a34f 40%, #f6f7fb 40.1%);
}

.brand {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
}

.title {
  margin-top: 32rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 完善资料（可选） */
.profile {
  margin-top: 56rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.profile-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #999;
  line-height: 1.2;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.nickname-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
}

/* 登录按钮 */
.login-btn {
  margin-top: 48rpx;
  background: #07c160;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(7, 193, 96, 0.35);
}

.login-btn::after {
  border: none;
}

.login-btn.disabled {
  opacity: 0.7;
}

.tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #999;
  line-height: 1.7;
}

/* 结果区 */
.result {
  margin-top: 48rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.result.error {
  border: 1rpx solid #fde2e2;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #07c160;
}

.result.error .result-title {
  color: #e64340;
}

.result-item {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
}

.k {
  font-size: 22rpx;
  color: #999;
}

.v {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: #333;
  word-break: break-all;
}

.v.token {
  font-family: monospace;
  font-size: 22rpx;
  color: #576b95;
}

.result-hint {
  display: block;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #aaa;
}
